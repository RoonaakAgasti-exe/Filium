# Secrets. .env.example is the template that IS committed; .env is the
# filled-in copy with real keys and must never be.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend build output
node_modules/
frontend/dist/
npm-debug.log*

# Model checkpoints — regenerate with ml/train_lstm.py rather than
# committing binaries that bloat the history.
*.pt
*.pth
ml/checkpoints/

# Hugging Face / FinBERT cache
.cache/
huggingface/

# Per-machine Claude Code settings (tool permissions granted on this box).
# .claude/settings.json would be shared config; the .local.json override
# is personal and shouldn't follow the repo around.
.claude/settings.local.json

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
