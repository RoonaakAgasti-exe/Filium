# Every environment variable this project reads, in one place.
#
# Copy to .env and fill in what you have. Nothing here is strictly
# required except DATABASE_URL — each integration degrades to a clear
# "not configured" message rather than a crash, and /health reports which
# ones are live. Leaving a `your_..._here` placeholder in place counts as
# NOT configured (see backend/config.py), so a half-edited copy of this
# file behaves like an empty one instead of producing confusing 401s.

# ============================================================
# Database — the only genuinely required setting
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fincopilot

# Backend connection pool bounds. Raise the max only if you also raise
# Postgres's own max_connections.
DB_POOL_MIN=1
DB_POOL_MAX=10

# ============================================================
# SEC EDGAR — no key, but the User-Agent is enforced
# ============================================================
# EDGAR blocks requests that don't identify themselves with a real name
# and email.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# ============================================================
# Price data (ingestion/fetch_prices.py)
# ============================================================
# Sources are tried in order: Alpaca -> FMP -> Yahoo. Yahoo needs no key,
# so price ingestion works on a fresh clone with none of these set.
# Alpaca credentials live in the paper trading section below.
#
# FMP: free tier at financialmodelingprep.com
FMP_API_KEY=your_fmp_key_here

# ============================================================
# News (ingestion/fetch_news.py)
# ============================================================
# Sources are tried in order: Finnhub -> NewsAPI -> Google News RSS.
# The RSS fallback needs no key. Finnhub gives the best per-company
# coverage and about a year of history; NewsAPI's free tier reaches back
# roughly 30 days, which is usually too short a sentiment history to
# train the augmented model on.
#
# finnhub.io
FINNHUB_API_KEY=your_finnhub_key_here
# newsapi.org
NEWS_API_KEY=your_news_key_here

# ============================================================
# Embeddings + LLM (RAG answers, faithfulness eval)
# ============================================================
OPENAI_API_KEY=your_openai_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ============================================================
# Paper trading (Alpaca) — doubles as a price source
# ============================================================
# Use PAPER keys, not live keys. The same credentials serve both the
# trading endpoints and price ingestion, so if trading works, prices work.
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# The free plan doesn't include the consolidated SIP feed — requesting it
# anyway returns a 403 that reads like an auth failure. Leave this as
# `iex` unless you're on a paid market data plan.
ALPACA_DATA_FEED=iex

# Starting cash for a newly created paper wallet, in dollars.
STARTING_CASH=100000

# ============================================================
# Email alert delivery (optional)
# ============================================================
# Alerts still fire and are stored without these — SMTP only controls
# whether they're also emailed out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ============================================================
# Deployment
# ============================================================
# Set to `production` in a real deployment.
ENVIRONMENT=development
# Comma-separated allowed origins, or * for any. Narrow this in production.
CORS_ORIGINS=*

# --- Used by docker-compose.yml specifically ---
POSTGRES_PASSWORD=change_this_in_production
JWT_SECRET_KEY=generate_a_long_random_string_here

# VITE_API_BASE_URL is deliberately left UNSET (commented out) below.
#
# Unset, docker-compose.yml defaults it to the same-origin path `/api`,
# which nginx.conf proxies to the backend container. That is the only
# value that works for a visitor who isn't sitting on the Docker host —
# `http://localhost:8000` resolves to *their* machine, not your server,
# and is a cross-origin request even on the host itself.
#
# Setting it here would override that default for anyone who follows
# DEPLOYMENT.md's `cp .env.example .env`, which is exactly how this gets
# broken silently: the app loads, then every API call fails.
#
# Only uncomment this if the frontend and backend live on genuinely
# different hosts, and then give it the backend's real public URL. Vite
# bakes it in at BUILD time, so a change needs `docker compose build
# frontend`, not a restart.
# VITE_API_BASE_URL=https://api.your-domain.example

# ============================================================
# Daily scheduler (ml/scheduler.py)
# ============================================================
# Hour of the day, server time, when the daily cycle fires. Default is
# after the US close and after most free providers publish the prior
# session — match it to your provider and your server's timezone.
SCHEDULER_HOUR=6
# Set to 0 to skip FinBERT sentiment scoring. That avoids a ~400MB model
# download in the scheduler container; predictions then run on whatever
# sentiment is already stored.
SCHEDULER_RUN_SENTIMENT=1
# How far back each daily run re-fetches. Short windows on purpose: enough
# to cover a long weekend plus a provider publishing late, without
# re-pulling years of history every morning against a rate-limited free tier.
SCHEDULER_PRICE_DAYS=7
SCHEDULER_NEWS_DAYS=3
